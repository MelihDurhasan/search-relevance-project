# LLM Judge (OpenAI uyumlu API)
OPENAI_API_KEY=
# İsteğe bağlı: Azure OpenAI veya başka bir uyumlu uç nokta
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Üç katmanlı model kıyası (nano=ucuz, mini=orta, gpt=güçlü). Boş bırakılırsa varsayılan id'ler kullanılır.
# OPENAI_MODEL_NANO=gpt-4o-mini
# OPENAI_MODEL_MINI=gpt-4o
# OPENAI_MODEL_GPT=gpt-4o
# Token tahmini (çağrı başına, maliyet hesabı için)
# EST_INPUT_TOKENS_PER_CALL=1400
# EST_OUTPUT_TOKENS_PER_CALL=280
